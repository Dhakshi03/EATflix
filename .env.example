# Copy to .env.local and fill in. NEVER commit .env.local.

# Required ONLY for AI photo analysis. Get a key at https://aistudio.google.com/apikey
# Server-side only: do not prefix with NEXT_PUBLIC_. The app works fully without it
# (manual logging, library, combinations, history, suggestions).
GEMINI_API_KEY=

# Optional: override the vision model (default: gemini-2.5-flash)
GEMINI_MODEL=
